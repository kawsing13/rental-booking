# Copy this file to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rental_booking
DB_USER=postgres
DB_PASSWORD=postgres

# JWT secrets - generate long random strings for real deployments, e.g.
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin allowed to call this API (CORS)
CLIENT_ORIGIN=http://localhost:5173

# SMTP (optional - password recovery / email notifications). Leave blank to
# disable email sending; the app will log emails to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Rental Booking App <no-reply@example.com>"

# GCash / Maya payment gateways run in MOCK mode until real credentials are
# supplied (see src/services/paymentService.js). Wire up a real provider
# (e.g. PayMongo, Xendit) by filling these in and flipping PAYMENTS_MOCK_MODE=false.
PAYMENTS_MOCK_MODE=true
GCASH_API_KEY=
MAYA_API_KEY=
